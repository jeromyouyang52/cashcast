# PayPal SANDBOX app (developer.paypal.com → Apps & Credentials → Sandbox). Server-side only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: CAD (default) or USD — must match what the sandbox business account accepts.
PAYPAL_CURRENCY=CAD
# Optional: Gemini API key (aistudio.google.com, free tier) so Copilot writes its own wording.
# Without it Copilot uses built-in templates. GEMINI_MODEL overrides the default Flash-Lite model.
GEMINI_API_KEY=
